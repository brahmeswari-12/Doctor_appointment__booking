# ================= Server =================
PORT=5000
NODE_ENV=development

# ================= Database (MySQL) =================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=doctor_appointment_db

# ================= Auth =================
# Use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=1d

# ================= CORS =================
CORS_ORIGIN=http://localhost:5173

# ================= Payments =================
# Leave RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET blank to use the built-in
# payment simulator (no external account needed - good for local development).
# Add your Razorpay test-mode keys to switch to the real gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_CURRENCY=INR
