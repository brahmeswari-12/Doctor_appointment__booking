{
  "name": "doctor-appointment-system",
  "version": "1.0.0",
  "private": true,
  "description": "Doctor Appointment Booking System - React + Express + MySQL",
  "keywords": [
    "doctor-appointment",
    "react",
    "express",
    "mysql",
    "healthcare"
  ],
  "license": "MIT",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:init": "npm --prefix backend run db:init",
    "db:seed": "npm --prefix backend run db:seed",
    "db:clean": "npm --prefix backend run db:clean",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev"
  }
}
